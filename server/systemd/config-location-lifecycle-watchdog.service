[Unit]
Description=Config Location Lifecycle Stale State Watchdog
After=config-location-lifecycle-sync.service
Wants=config-location-lifecycle-sync.service

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/config-location

Environment=PYTHONPATH=/opt/config-location
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/config-location/venv/bin/python -m app.health.lifecycle.stale_watchdog

Restart=always
RestartSec=5

Nice=15

IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/var/lib/config-location/health-lifecycle
ReadOnlyPaths=/var/lib/config-location/health-results/latest
ReadOnlyPaths=/var/lib/config-location/configs

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
