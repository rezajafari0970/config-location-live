[Unit]
Description=Config Location Permanent Canary Readiness Controller
After=network-online.target config-location-removal-wait.service
Wants=network-online.target
Requires=config-location-removal-wait.service

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/config-location

Environment=PYTHONPATH=/opt/config-location
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/config-location/venv/bin/python -m app.health.lifecycle.canary_readiness_controller

Restart=always
RestartSec=5

TimeoutStopSec=20
KillSignal=SIGTERM

Nice=9

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
