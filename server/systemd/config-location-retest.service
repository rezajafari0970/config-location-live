[Unit]
Description=Config Location Permanent Health Retest Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/opt/config-location

Environment=PYTHONPATH=/opt/config-location
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/config-location/venv/bin/python -m app.health.retest.worker

Restart=always
RestartSec=5

TimeoutStopSec=30
KillSignal=SIGTERM

Nice=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
