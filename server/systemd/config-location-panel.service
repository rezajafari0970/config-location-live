[Unit]
Description=Config Location Management Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=configloc
Group=configloc

WorkingDirectory=/opt/config-location

EnvironmentFile=/etc/config-location/panel.env

ExecStart=/opt/config-location/venv/bin/python -m app.panel.server

Restart=always
RestartSec=3

TimeoutStartSec=30
TimeoutStopSec=15

KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true

ProtectSystem=full
ProtectHome=true

ReadWritePaths=/var/lib/config-location
ReadWritePaths=/var/log/config-location
ReadWritePaths=/run/config-location

CapabilityBoundingSet=
AmbientCapabilities=

RestrictSUIDSGID=true

LockPersonality=true

[Install]
WantedBy=multi-user.target
