[Unit]
Description=Config Location Fetch Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=configloc
Group=configloc

WorkingDirectory=/opt/config-location

ExecStart=/opt/config-location/venv/bin/python -m app.fetcher.engine

Restart=always
RestartSec=3

TimeoutStartSec=30
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

ReadWritePaths=/var/lib/config-location
ReadWritePaths=/var/log/config-location

RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
