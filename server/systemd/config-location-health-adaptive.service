[Unit]
Description=Config Location Always-On Adaptive Health Controller
After=network-online.target config-location-fetcher.service config-location-panel.service
Wants=network-online.target
Requires=config-location-fetcher.service

[Service]
Type=simple

ExecStart=/opt/config-location/bin/health-adaptive-daemon

Restart=always
RestartSec=3

TimeoutStopSec=90
KillMode=control-group

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true

LimitNOFILE=65535
TasksMax=4096

NoNewPrivileges=true
PrivateTmp=true

ProtectSystem=full
ProtectHome=true

ReadWritePaths=/var/lib/config-location
ReadWritePaths=/var/log/config-location
ReadWritePaths=/run
ReadWritePaths=/etc/config-location

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/config-location

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
