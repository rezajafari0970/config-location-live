[Unit]
Description=Config Location Health History Retention GC
After=local-fs.target
ConditionPathIsDirectory=/var/lib/config-location/health-results/history

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/config-location

Environment=PYTHONPATH=/opt/config-location
Environment=CONFIG_LOCATION_HISTORY_RETENTION_HOURS=72
Environment=CONFIG_LOCATION_HISTORY_MIN_KEEP=20
Environment=CONFIG_LOCATION_HISTORY_GC_MAX=10000

ExecStart=/opt/config-location/venv/bin/python -m app.integrity.health_history_gc

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
