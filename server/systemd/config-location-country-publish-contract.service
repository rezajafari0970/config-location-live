[Unit]
Description=Config Location Country Publish Permanent Contract Guard
After=network-online.target config-location-panel.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/config-location
Environment=PYTHONPATH=/opt/config-location
ExecStart=/opt/config-location/venv/bin/python -m app.country.publish_contract_guard
TimeoutStartSec=45
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
