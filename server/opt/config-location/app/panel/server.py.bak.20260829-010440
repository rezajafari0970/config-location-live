async def source_add(request):

    data = await request.post()

    try:

        source, duplicate = add_source(
            url=data.get(
                "url",
                ""
            ),
            name=data.get(
                "name",
                ""
            ),
            interval=data.get(
                "interval",
                "60"
            ),
        )

        msg = (
            "این URL قبلاً وجود داشت و ادغام شد."
            if duplicate
            else
            "Source با موفقیت اضافه شد."
        )

        raise web.HTTPFound(
            f"/?msg={msg}"
        )

    except web.HTTPException:
        raise

    except Exception as e:
        raise web.HTTPFound(
            f"/?error={str(e)}"
        )



async def source_bulk_add(request):

    data = await request.post()

    raw_urls = str(
        data.get(
            "urls",
            ""
        )
    )

    lines = raw_urls.splitlines()

    interval = data.get(
        "interval",
        "60"
    )

    fetch_mode = "auto"
    enabled = True
    fetch_immediately = True

    try:

        result = add_sources_bulk(
            urls=lines,
            interval=interval,
            fetch_mode=fetch_mode,
            enabled=enabled,
            fetch_immediately=fetch_immediately,
        )

        msg = (
            f"Import انجام شد | "
            f"جدید: {result['added']} | "
            f"ادغام: {result['merged']} | "
            f"نامعتبر: {result['invalid']}"
        )

        if result[
            "invalid_items"
        ]:

            details = " | ".join(
                item["url"]
                for item
                in result[
                    "invalid_items"
                ][:5]
            )

            msg += (
                f" | Invalid: {details}"
            )

        raise web.HTTPFound(
            f"/?msg={msg}"
        )

    except web.HTTPException:
        raise

    except Exception as e:

        raise web.HTTPFound(
            f"/?error={str(e)}"
        )



