            url=data.get(
                "url",
                ""
            ),
            name=data.get(
                "name",
                ""
            ),
            interval=data.get(
                "interval",
                "60"
            ),
        )

        raise web.HTTPFound(
            "/?msg=Source ویرایش شد."
        )

    except web.HTTPException:
        raise

    except Exception as e:
        raise web.HTTPFound(
            f"/?error={str(e)}"
        )


async def source_delete(request):

    source_id = request.match_info[
        "source_id"
    ]

    deleted = delete_source(
        source_id
    )

    msg = (
        "Source حذف شد."
        if deleted
        else
        "Source پیدا نشد."
    )

    raise web.HTTPFound(
        f"/?msg={msg}"
    )



async def source_delete_selected(request):

    data = await request.post()

    selected = data.getall(
        "source_ids",
        []
    )

    deleted = delete_sources(
        selected
    )

    raise web.HTTPFound(
        f"/?msg={deleted} Source حذف شد."
    )


async def source_delete_all(request):

    deleted = delete_all_sources()

    raise web.HTTPFound(
        f"/?msg={deleted} Source حذف شد."
    )



async def source_toggle(request):

    source_id = request.match_info[
        "source_id"
    ]

    src = get_source(
        source_id
    )

    if not src:
        raise web.HTTPNotFound()

    set_enabled(
        source_id,
        not bool(
            src.get("enabled")
        )
    )

    raise web.HTTPFound(
        "/?msg=وضعیت Source تغییر کرد."
    )


