FETCH_STATUS_FILE = Path(
    "/var/lib/config-location/state/fetcher-status.json"
)


def get_fetcher_status():

    default = {
        "status": "not_started",
        "running": False,
        "last_cycle_at": None,
        "last_success_at": None,
        "current_source": None,
        "cycle": 0,
    }

    try:

        if not FETCH_STATUS_FILE.exists():
            return default

        import json

        data = json.loads(
            FETCH_STATUS_FILE.read_text(
                encoding="utf-8"
            )
        )

        if not isinstance(
            data,
            dict
        ):
            return default

        result = default.copy()
        result.update(data)

        return result

    except Exception:

        return default



