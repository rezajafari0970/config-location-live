async def self_test(request):

    tests = []

    def add(name, ok, info=""):
        tests.append({
            "name": name,
            "ok": bool(ok),
            "info": str(info),
        })

    try:

        source_dir = Path(
            "/var/lib/config-location/sources"
        )

        add(
            "Source storage directory",
            source_dir.is_dir(),
            source_dir
        )

    except Exception as e:

        add(
            "Source directory",
            False,
            e
        )

    try:

        test_file = Path(
            "/var/lib/config-location/state/panel-self-test.tmp"
        )

        test_file.write_text(
            "ok",
            encoding="utf-8"
        )

        ok = (
            test_file.read_text(
                encoding="utf-8"
            )
            == "ok"
        )

        test_file.unlink(
            missing_ok=True
        )

        add(
            "Storage write test",
            ok
        )

    except Exception as e:

        add(
            "Storage write test",
            False,
            e
        )

    try:

        current = list_sources()

        add(
            "Source database readable",
            isinstance(
                current,
                list
            ),
            f"{len(current)} sources"
        )

    except Exception as e:

        add(
            "Source database readable",
            False,
            e
        )

    add(
        "Panel authentication",
        is_authenticated(request),
        "Persistent session active"
    )

    all_ok = all(
        item["ok"]
        for item in tests
    )

    rows = "".join(
        f"""
<tr>
<td>{esc(t["name"])}</td>
<td>
{"✅ OK" if t["ok"] else "❌ FAIL"}
</td>
<td>
{esc(t["info"])}
</td>
</tr>
"""
        for t in tests
    )

    content = f"""
<div class="card">

<h2>
{
"✅ SYSTEM TEST PASSED"
if all_ok
else
"❌ SYSTEM TEST FAILED"
}
</h2>

<table>

<tr>
<th>Test</th>
<th>Status</th>
<th>Details</th>
</tr>

{rows}

</table>

<br>

<a
    class="button"
    href="/"
>
بازگشت به پنل
</a>

</div>
"""

    return page(
        "System Test",
        content
    )


