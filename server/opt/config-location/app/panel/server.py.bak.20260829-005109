async def login_post(request):
    data = await request.post()

    username = str(
        data.get("username", "")
    )

    password = str(
        data.get("password", "")
    )

    valid_user = hmac.compare_digest(
        username,
        ADMIN_USER
    )

    valid_password = hmac.compare_digest(
        password,
        ADMIN_PASSWORD
    )

    if not (
        valid_user
        and valid_password
    ):
        raise web.HTTPFound(
            "/login?error=نام کاربری یا رمز عبور اشتباه است."
        )

    token_raw = (
        secrets.token_urlsafe(32)
        + SESSION_SECRET
    )

    token = hashlib.sha256(
        token_raw.encode()
    ).hexdigest()

    sessions[token] = time.time()

    response = web.HTTPFound("/")

    response.set_cookie(
        SESSION_COOKIE,
        token,
        httponly=True,
        samesite="Lax",
        max_age=SESSION_TTL,
        path="/",
    )

    raise response


async def logout(request):
    token = request.cookies.get(
        SESSION_COOKIE
    )

    if token:
        sessions.pop(
            token,
            None
        )

    response = web.HTTPFound("/login")

    response.del_cookie(
        SESSION_COOKIE,
        path="/"
    )

    raise response


