async def source_delete(request):
    source_id = request.match_info[
        "source_id"
    ]

    deleted = delete_source(
        source_id
    )

    msg = (
        "Source حذف شد."
        if deleted
        else
        "Source پیدا نشد."
    )

    raise web.HTTPFound(
        f"/?msg={msg}"
    )


async def source_toggle(request):
    source_id = request.match_info[
        "source_id"
    ]

    src = get_source(
        source_id
    )

    if not src:
        raise web.HTTPNotFound()

    set_enabled(
        source_id,
        not bool(
            src.get("enabled")
        )
    )

    raise web.HTTPFound(
        "/?msg=وضعیت Source تغییر کرد."
    )


