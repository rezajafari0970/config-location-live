async def source_add(request):
    data = await request.post()

    try:
        source, duplicate = add_source(
            url=data.get(
                "url",
                ""
            ),
            name=data.get(
                "name",
                ""
            ),
            interval=data.get(
                "interval",
                "60"
            ),
        )

        msg = (
            "این URL قبلاً وجود داشت و ادغام شد."
            if duplicate
            else
            "Source با موفقیت اضافه شد."
        )

        raise web.HTTPFound(
            f"/?msg={msg}"
        )

    except web.HTTPException:
        raise

    except Exception as e:
        raise web.HTTPFound(
            f"/?error={str(e)}"
        )


