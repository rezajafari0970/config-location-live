# ============================================================

async def self_test(
    request
):
    tests = []

    def add(
        name,
        ok,
        info=""
    ):
        tests.append({
            "name": name,
            "ok": bool(ok),
            "info": str(info),
        })

    try:
        current = list_sources()

        add(
            "Source database",
            isinstance(
                current,
                list
            ),
            f"{len(current)} sources"
        )

    except Exception as e:
        add(
            "Source database",
            False,
            e
        )

    try:
        test_path = Path(
            "/var/lib/config-location/state/panel-self-test.tmp"
        )

        test_path.write_text(
            "OK",
            encoding="utf-8"
        )

        result = (
            test_path.read_text(
                encoding="utf-8"
            )
            == "OK"
        )

        test_path.unlink(
            missing_ok=True
        )

        add(
            "Storage write",
            result
        )

    except Exception as e:
        add(
            "Storage write",
            False,
            e
        )

    add(
        "Authentication",
        is_authenticated(
            request
        )
    )

    rows = ""

    for test in tests:
        rows += f"""
<tr>

<td>
{esc(test["name"])}
</td>

<td>
{
"✅ OK"
if test["ok"]
else
"❌ FAIL"
}
</td>

<td>
{esc(test["info"])}
</td>

</tr>
"""

    passed = all(
        test["ok"]
        for test in tests
    )

    content = f"""

<div class="card">

<h2>
{
"✅ SYSTEM TEST PASSED"
if passed
else
"❌ SYSTEM TEST FAILED"
}
</h2>

<table>

<thead>
<tr>
<th>Test</th>
<th>Status</th>
<th>Details</th>
</tr>
</thead>

<tbody>
{rows}
</tbody>

</table>

<br>

<a
 class="button"
 href="/"
>
بازگشت
</a>

</div>
"""

    return page(
        "System Test",
        content
    )


