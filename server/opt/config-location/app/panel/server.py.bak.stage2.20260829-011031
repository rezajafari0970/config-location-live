async def source_add(
    request
):
    data = await request.post()

    try:
        _, duplicate = add_source(
            url=data.get(
                "url",
                ""
            ),

            name=data.get(
                "name",
                ""
            ),

            interval=data.get(
                "interval",
                "60"
            ),
        )

        if duplicate:
            redirect_home(
                "این URL از قبل وجود داشت و ادغام شد."
            )

        redirect_home(
            "Source با موفقیت اضافه شد."
        )

    except web.HTTPException:
        raise

    except Exception as e:
        redirect_home(
            error=str(e)
        )


