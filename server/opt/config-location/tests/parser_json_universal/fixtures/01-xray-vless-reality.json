        "realitySettings": {
          "serverName": "www.cloudflare.com",
          "publicKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "shortId": "abcd",
          "spiderX": "/"
